{
  "name": "test-minimal-nodejs-app",
  "version": "2.0.0",
  "description": "A minimal Node.js task manager project with a build process",
  "main": "dist/bundle.js",
  "scripts": {
    "start": "node dist/bundle.js",
    "build": "npx esbuild src/index.js --bundle --outfile=dist/bundle.js --minify",
    "dev": "nodemon dist/bundle.js",
    "lint": "npx eslint src"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "editor.md": "1.5.0",
    "express": "4.18.2",
    "lodash": "4.17.12",
    "moin": "1.2.0",
    "morgan": "^1.10.0",
    "pm2": "5.3.0",
    "protobufjs": "^7.6.1",
    "vm2": "3.9.4"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "eslint": "^8.49.0",
    "nodemon": "^2.0.22"
  }
}
