{
  "name": "test-minimal-nodejs-app",
  "version": "5.5.5",
  "description": "A minimal Node.js task manager project for Frogbot security testing",
  "main": "dist/bundle.js",
  "scripts": {
    "start": "node dist/bundle.js",
    "build": "npx esbuild src/index.js --bundle --outfile=dist/bundle.js --minify",
    "dev": "nodemon dist/bundle.js",
    "lint": "npx eslint src"
  },
  "dependencies": {
    "express": "4.18.2",
    "cors": "2.8.6",
    "dotenv": "16.0.0",
    "editor.md": "1.5.0",
    "lodash": "4.17.12",
    "protobufjs": "6.11.2",
    "vm2": "3.9.4",
    "pm2": "5.3.0",
    "moin": "1.2.0",
    "morgan": "1.10.0",
    "axios": "0.21.1",
    "minimist": "1.2.0",
    "path-parse": "1.0.6",
    "node-fetch": "2.6.1"
  },
  "devDependencies": {
    "esbuild": "0.19.0",
    "eslint": "8.49.0",
    "nodemon": "2.0.22"
  }
}